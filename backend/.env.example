# Copy to backend/.env (gitignored) and fill in.
# Then `export $(grep -v '^#' backend/.env | xargs)` before running dev-up.sh.

HOMEAUTH_BASE_URL=http://localhost:8080
# URL pública (la que ve el navegador) — sólo necesaria cuando BASE_URL es un
# hostname interno (p.ej. http://home-auth:9876 en Coolify). En dev déjala vacía.
# HOMEAUTH_PUBLIC_URL=https://auth.tudominio.com
HOMEAUTH_APP_API_KEY=

# Defaults are fine for dev — uncomment to override.
# SESSION_COOKIE_NAME=ytdl_session
# SESSION_COOKIE_SECURE=false       # set to "true" in production behind HTTPS
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_DAYS=7
# ACCESS_REFRESH_LEEWAY_SEC=60

# CORS: leave empty when backend serves the SPA from the same origin (Docker /
# Coolify). Set only if the SPA runs on a different host (dev with separate
# Vite server uses the Vite proxy, so still leave empty).
# FRONTEND_ORIGIN=

# Dev-only: bypass HomeAuth and treat every request as a fixed ADMIN user.
# Useful for testing new features without logging in. NEVER set in production.
# The backend logs a loud banner at startup when this is on.
# DEV_AUTH_BYPASS=1
