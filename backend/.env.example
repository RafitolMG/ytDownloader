# Copy to backend/.env (gitignored) and fill in.
# Then `export $(grep -v '^#' backend/.env | xargs)` before running dev-up.sh.

HOMEAUTH_BASE_URL=http://localhost:8080
# URL pública (la que ve el navegador) — sólo necesaria cuando BASE_URL es un
# hostname interno (p.ej. http://home-auth:9876 en Coolify). En dev déjala vacía.
# HOMEAUTH_PUBLIC_URL=https://auth.tudominio.com
HOMEAUTH_APP_API_KEY=

# Defaults are fine for dev — uncomment to override.
# SESSION_COOKIE_NAME=ytdl_session
# SESSION_COOKIE_SECURE=false       # set to "true" in production behind HTTPS
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_DAYS=7
# ACCESS_REFRESH_LEEWAY_SEC=60

# CORS: leave empty when backend serves the SPA from the same origin (Docker /
# Coolify). Set only if the SPA runs on a different host (dev with separate
# Vite server uses the Vite proxy, so still leave empty).
# FRONTEND_ORIGIN=

# Dev-only: bypass HomeAuth and treat every request as a fixed ADMIN user.
# Useful for testing new features without logging in. NEVER set in production.
# The backend logs a loud banner at startup when this is on.
# DEV_AUTH_BYPASS=1

# yt-dlp cookies (Netscape format). Required in production: YouTube blocks
# datacenter IPs (Coolify / VPS) unless requests carry a logged-in session.
# In dev you can leave both empty — your residential IP works without cookies.
#
# How to obtain a cookies.txt:
#   1. Install the "Get cookies.txt LOCALLY" browser extension.
#   2. Log into youtube.com in that browser.
#   3. Export cookies for the youtube.com domain.
#
# Two ways to supply it (DATA wins over FILE if both are set):
#
# (a) Recommended for Coolify — paste a base64-encoded cookies.txt into an
#     env var. base64 keeps the value on a single line so Coolify can source
#     the env file as bash without choking on the tab-separated Netscape
#     format. Renewing means re-encoding and pasting; no SSH, no file mounts.
#     Mark it as secret.
#       base64 -w0 cookies.txt | xclip -selection clipboard   # Linux
#       base64 -i cookies.txt | pbcopy                        # macOS
# YT_COOKIES_DATA=IyBOZXRzY2FwZSBIVFRQIENvb2tpZSBGaWxlCi55b3V0dWJlLmNvbQlUUlVF...
#
# (b) When the file is already on disk (bind-mount, persistent volume):
# YT_COOKIES_FILE=/app/data/cookies.txt
#
# The startup banner logs which source loaded — check the container logs.
