# Copy to backend/.env (gitignored) and fill in.
# Then `export $(grep -v '^#' backend/.env | xargs)` before running dev-up.sh.

HOMEAUTH_BASE_URL=http://localhost:8080
HOMEAUTH_APP_API_KEY=

# Defaults are fine for dev — uncomment to override.
# SESSION_COOKIE_NAME=ytdl_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_DAYS=7
# ACCESS_REFRESH_LEEWAY_SEC=60
# FRONTEND_ORIGIN=http://localhost:5273
